# Copy to .env and fill, or use install.sh wizard
# Used by Docker and (optionally) by bot.py — env overrides config.json

BOT_TOKEN=123456:ABC-your-token-from-BotFather
ADMIN_IDS=123456789
# comma-separated for multiple admins: 123456789,987654321

ASSET=USDT
FIAT=USD
INTERVAL=60

# Choose the state database: auto (default), file, or redis.
# auto uses Redis whenever a complete REST URL + token pair exists, otherwise data.json.
# file always uses data.json even if Redis credentials are present; redis requires a
# complete KV/Redis pair and never silently falls back to a separate file database.
# P2P_STATE_BACKEND=auto
# P2P_STORAGE_BACKEND=auto  # accepted alias for P2P_STATE_BACKEND

# Where to keep data.json when the file backend is used (systemd/Docker/local)
# P2P_DATA_DIR=/var/lib/p2p-bot

# The "connect a database" link the bot shows when no shared database is
# connected (🔌 Connect database / /database, the setup page and the status page).
# Defaults to Vercel's Storage page — where "Connect to this project" writes
# KV_REST_API_URL + KV_REST_API_TOKEN. Point it at your own storage page, an
# Upstash console or a self-hosted Redis if you prefer.
# P2P_DATABASE_LINK=https://vercel.com/dashboard/stores

# Optional ad-link templates (JSON). Buttons open merchant profiles by default;
# enable the ad target in Settings to use these. Defaults live in adlinks.py;
# override any exchange here or from the bot UI (Settings ▸ 🔗 Ad links).
# AD_LINK_TEMPLATES={"okx": "https://www.okx.com/p2p-markets/{FIAT_LOWER}/{TAKER_SIDE}-{ASSET_LOWER}?adId={AD_ID}"}

# ── Vercel / serverless (webhook) mode ─────────────────────────────────────
# Vercel runs one Python function per request, so the bot switches to webhook
# mode there: Telegram pushes updates to https://<app>.vercel.app/api/webhook
# and a Vercel Cron calls /api/tick for the periodic work (see VERCEL.md).
# Deploying to Vercel only needs BOT_TOKEN + ADMIN_IDS + the KV pair below.

# State store — REQUIRED on Vercel: functions have no persistent disk, so
# without it the bot forgets its group, merchants and prices between requests.
# Any of these pairs works (Vercel KV / Upstash Redis integration sets KV_*):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional: name of the key the state is stored under (default p2p-price-bot:state)
# P2P_STATE_KEY=

# Optional: let the setup page detect a database that is already connected and
# skip the database step. Without a token it asks nothing over the network; with
# VERCEL_TOKEN (or P2P_VERCEL_TOKEN) + VERCEL_PROJECT_ID it asks Vercel which
# store is connected to this project and says "detected — step skipped" instead
# of walking you through creating a second one. Read-only, cached, never fatal.
# VERCEL_TOKEN=
# P2P_VERCEL_PROJECT_ID=   # defaults to VERCEL_PROJECT_ID / VERCEL_PROJECT_NAME
# P2P_VERCEL_TEAM_ID=      # defaults to VERCEL_TEAM_ID

# ── Setup without a redeploy (browser form /api/setup + `python setup_cli.py`) ──
# Both store BOT_TOKEN / ADMIN_IDS / ASSET / FIAT / INTERVAL in the state store
# instead of the environment, and the bot picks them up on the next request.
# Environment variables always win over stored values.
# P2P_CONFIG_KEY=p2p-price-bot:config      # Redis key the settings are stored under
# P2P_RUNTIME_CONFIG_FILE=                 # file used when there is no Redis
#                                           # (default: runtime_config.json next to data.json)

# Locks the browser form: when set, /api/setup only accepts a submission that
# carries it (form field, ?secret= or "Authorization: Bearer"). Without it the
# form is open while the deployment is unconfigured and closes once it is ready —
# then the 🔧 Reconfigure button on /api/setup sends the admins a one-time link in
# Telegram that reopens it (no redeploy, no dashboard). Set this if you would
# rather use a fixed secret, or when the bot token itself is broken.
# SETUP_SECRET=

# Public URL of the deployment (only needed when it cannot be auto-detected —
# Vercel provides VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL automatically).
# PUBLIC_URL=https://my-bot.vercel.app

# Secret Telegram must send with every webhook update. Empty = derived from
# BOT_TOKEN (unguessable, nothing to configure). Set your own random string if
# you prefer: openssl rand -hex 16
# WEBHOOK_SECRET=

# Locks down /api/tick: Vercel Cron then calls it with
# "Authorization: Bearer <CRON_SECRET>". Recommended.
# CRON_SECRET=

# Re-registering the webhook drops updates Telegram queued while you were
# offline (default 1). Set to 0 to replay them after a redeploy.
# WEBHOOK_DROP_PENDING=1
